<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Material3 monochrome theme -->
    <style name="Theme.Poverka" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Toolbar style -->
    <style name="Theme.Poverka.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/primary</item>
        <item name="navigationIconTint">@color/primary</item>
        <item name="android:background">@color/background</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.Poverka.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.Poverka.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.Poverka.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="rippleColor">@color/divider</item>
    </style>

    <style name="Widget.Poverka.Button.Icon" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="strokeColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- FAB -->
    <style name="Widget.Poverka.Fab" parent="Widget.Material3.ExtendedFloatingActionButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
    </style>

    <!-- Card style -->
    <style name="Widget.Poverka.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/background</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
